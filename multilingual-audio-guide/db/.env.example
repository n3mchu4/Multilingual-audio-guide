# PostgreSQL application login, NOT the Admin/Manager login in USERS.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=saigon_audio_guide
PGUSER=guide_app
PGPASSWORD=CHANGE_ME_TO_THE_GUIDE_APP_PASSWORD

# Standalone read-only demo API and local development storage.
DB_API_PORT=3002
DB_API_CORS_ORIGIN=http://localhost:5173
STORAGE_MODE=local
STORAGE_PUBLIC_BASE_URL=http://localhost:3002/media
# Cloud mode example:
# STORAGE_MODE=cloud
# STORAGE_PUBLIC_BASE_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public
# No cloud admin key is required for manually uploading in the dashboard.
